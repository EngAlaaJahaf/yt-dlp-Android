<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:clipToPadding="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dialogMainCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border_card"
        app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- الشريط العلوي للنافذة: العنوان وزر الإغلاق -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/video_preview"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/dialogCloseBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_settings_icon"
                android:src="@drawable/ic_close"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="@string/btn_close"
                android:scaleType="centerInside" />
        </RelativeLayout>

        <!-- حاوية الصورة الحقيقية المصغرة (نسبة 16:9 عصرية) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dialogThumbCard"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_card"
            app:cardBackgroundColor="@color/vidmate_dark"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- الصورة الحقيقية للفيديو -->
                <ImageView
                    android:id="@+id/dialogThumbImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null" />

                <!-- زر تشغيل شبه شفاف في المنتصف -->
                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_play_circle" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play"
                    app:tint="@color/vidmate_red"
                    android:contentDescription="@null" />

                <!-- شارة مدة الفيديو -->
                <TextView
                    android:id="@+id/dialogDurText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="8dp"
                    android:background="#CC08090C"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    tools:text="10:34" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- عنوان الفيديو -->
        <TextView
            android:id="@+id/dialogTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginTop="12dp"
            android:textIsSelectable="true"
            tools:text="عنوان الفيديو الحقيقي بجودة عالية الدقة" />

        <!-- اسم القناة / الناشر -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_info"
                app:tint="@color/vidmate_red"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/dialogUploaderText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginStart="6dp"
                tools:text="اسم القناة أو الناشر" />
        </LinearLayout>

        <!-- صف الشارات: المنصة + الحجم الفعلي + الجودة والصيغة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dialogSizeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="#141C63E1"
                android:textColor="@color/vidmate_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                tools:text="الحجم الفعلي: 45.2 MB" />

            <TextView
                android:id="@+id/dialogQualityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="#148A8A8E"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                tools:text="1080p • MP4" />
        </LinearLayout>

        <!-- أزرار الإجراءات في الأسفل -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <!-- زر مشاهدة الفيديو في التطبيق أو المتصفح -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogWatchBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/watch_video"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_card"
                app:icon="@drawable/ic_play"
                app:iconTint="?attr/colorOnSurface"
                app:iconSize="16dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- زر بدء التحميل المباشر -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogDownloadBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.2"
                android:text="@string/btn_download"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/vidmate_red"
                app:icon="@drawable/ic_download"
                app:iconTint="@color/white"
                app:iconSize="16dp"
                style="@style/Widget.Material3.Button" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
</FrameLayout>

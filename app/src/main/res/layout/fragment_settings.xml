                    android:src="@drawable/ic_chevron"
                    app:tint="?android:attr/textColorTertiary"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="@string/downloads_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/clearFinishedBtn"
            android:text="@string/btn_clear_finished"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:backgroundTint="@color/action_cancel"
            app:cornerRadius="16dp"
            android:layout_width="wrap_content"
            android:layout_height="40dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyText"
        android:text="@string/downloads_empty"
        android:visibility="gone"
        android:layout_marginTop="24dp"
        android:textSize="14sp"
        android:alpha="0.6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/downloadsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

</LinearLayout>

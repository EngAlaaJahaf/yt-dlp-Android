<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_card"
    app:cardBackgroundColor="?attr/colorSurface">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- شريط الحالة الجانبي الملون (مطابق للموكب .dcard::before) -->
        <View
            android:id="@+id/sideStripe"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/bg_side_stripe" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

        <!-- المُصغّرة المتدرجة مع دوائر التشغيل (مطابق للموكب) -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_thumb_gradient">

            <View
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_play_circle" />

            <ImageView
                android:id="@+id/mediaIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_video"
                app:tint="@color/vidmate_red"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- العمود الأوسط -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/urlText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"
                tools:text="اسم الفيديو التوضيحي عالي الدقة" />

            <!-- شارة الحالة ذات الخلفية الملونة الناعمة + شارة الحجم -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:background="@drawable/bg_badge_pill"
                    tools:text="جارٍ التحميل" />

                <TextView
                    android:id="@+id/sizeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="#0F000000"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone"
                    tools:text="45.2 MB"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- شريط التقدم المصغر -->
            <ProgressBar
                android:id="@+id/itemProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="100"
                android:layoutDirection="ltr"
                android:progressDrawable="@drawable/bg_progress_fill"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                tools:visibility="visible"
                tools:progress="45" />

            <!-- البيانات الوصفية + أزرار التحكم -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/infoText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="10.5sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="1080p • MP4 • 22/10 17:40" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPause"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:icon="@drawable/ic_pause"
                    app:iconTint="@color/white"
                    android:backgroundTint="#FFF57C00"
                    android:contentDescription="@string/status_paused"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResume"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:icon="@drawable/ic_play"
                    app:iconTint="@color/white"
                    android:backgroundTint="#FF43A047"
                    android:contentDescription="@string/action_resume"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:icon="@drawable/ic_refresh"
                    app:iconTint="@color/white"
                    android:backgroundTint="?attr/colorPrimary"
                    android:contentDescription="@string/action_retry"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlay"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:icon="@drawable/ic_open"
                    app:iconTint="?attr/colorOnSurface"
                    android:backgroundTint="?attr/colorSurfaceVariant"
                    android:contentDescription="@string/btn_play"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="?attr/colorError"
                    android:contentDescription="@string/action_delete" />
            </LinearLayout>

            <!-- التفاصيل اللحظية (سرعة وأحجام) -->
            <TextView
                android:id="@+id/metricsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp"
                tools:text="45.2 MB / 120.5 MB • 3.2 MB/s • 45%" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>

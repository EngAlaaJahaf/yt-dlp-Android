<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ═══ الثيم الرئيسي (فاتح + داكن تلقائي) ═══ -->
    <style name="Theme.YtDlpGui" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_purple_light</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/download_start</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="android:statusBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="fontFamily">@font/cairo</item>
        <item name="android:fontFamily">@font/cairo</item>
    </style>

    <!-- ═══ الأنماط المشتركة ═══ -->

    <!-- بطاقة موحدة -->
    <style name="AppCard" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- زر مربع صغير (إرث — يُستخدم في الإعدادات) -->
    <style name="AppBtn.Square" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- شريحة خيارات VidMate (Pill Option) -->
    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1.2dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipIconTint">@color/chip_icon_selector</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <!-- مؤشر شفاف لشريط التنقل السفلي (بدون حبة M3) -->
    <style name="Widget.App.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- نمط الحاوية السفلية بنافذة حوارية ذات زوايا مستديرة وخلفية شفافة -->
    <style name="Theme.App.BottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
    </style>
    <style name="Widget.App.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
